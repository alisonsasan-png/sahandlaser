lightbox-img\" src=\"\" alt=\"Expanded Image\"\u003e\r\n\u003c/div\u003e\r\n\r\n\u003cstyle\u003e\r\n.product-gallery {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  font-family: \u0027Vazirmatn\u0027, sans-serif;\r\n}\r\n\r\n.main-image-wrapper {\r\n  display: flex;\r\n  flex-direction: row-reverse; /* تصاویر کوچک سمت راست */\r\n  align-items: flex-start;\r\n  gap: 15px;\r\n}\r\n\r\n.main-image img {\r\n  width:500px;\r\n  height: auto;\r\n  border-radius: 20px;\r\n  cursor: pointer;\r\n  transition: transform 0.3s;\r\n}\r\n\r\n.thumbnails {\r\n  display: flex;\r\n  flex-direction: column; /* تصاویر کوچک به صورت ستونی */\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n/* تصاویر کوچک */\r\n.thumbnails img {\r\n  width: 65px;\r\n  height: auto;\r\n  cursor: pointer;\r\n  border-radius: 10px;\r\n  transition: transform 0.3s, border 0.3s;\r\n}\r\n\r\n.thumbnails img:hover, .thumbnails img.selected {\r\n  border: 2px solid #0b548e;\r\n  border-radius: 10px;\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* دکمه دانلود عمودی (حالت دسکتاپ) */\r\n.catalog-download {\r\n  width: 60px;\r\n  height: 120px;\r\n  margin-top: 10px;\r\n  background: #e51e28;\r\n  color: #fff;\r\n  border-radius: 10px;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  font-weight: bold;\r\n  text-decoration: none;\r\n  text-align: center;\r\n  writing-mode: vertical-rl;\r\n  transform: rotate(180deg);\r\n  transition: background 0.3s;\r\n}\r\n.catalog-download:hover {\r\n  background: #c91821;\r\n  color: #fff;\r\n}\r\n\r\n/* Lightbox */\r\n#lightbox {\r\n  display: none;\r\n  position: fixed;\r\n  top:0;\r\n  left:0;\r\n  width:100%;\r\n  height:100%;\r\n  background: rgba(0,0,0,0.8);\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 9999;\r\n}\r\n#lightbox img {\r\n  max-width: 90%;\r\n  max-height: 90%;\r\n}\r\n\r\n/* --- ریسپانسیو موبایل/تبلت --- */\r\n@media (max-width: 768px) {\r\n  .main-image-wrapper {\r\n    flex-direction: column;\r\n    align-items: center;\r\n  }\r\n  .main-image img {\r\n    width: 100%;\r\n    max-width: 520px;\r\n  }\r\n  .thumbnails {\r\n    flex-direction: row;\r\n    justify-content: center;\r\n    flex-wrap: wrap;\r\n  }\r\n  .thumbnails img {\r\n    width: 80px;\r\n    height: auto;\r\n  }\r\n  .catalog-download {\r\n    width: auto;\r\n    height: auto;\r\n    padding: 12px 20px;\r\n    margin-top: 15px;\r\n    writing-mode: horizontal-tb;\r\n    transform: none;\r\n    border-radius: 30px;\r\n  }\r\n}\r\n\u003c/style\u003e\r\n\r\n\u003cscript\u003e\r\nfunction selectImage(element) {\r\n  document.getElementById(\u0027current\u0027).src = element.src;\r\n\r\n  const thumbnails = document.querySelectorAll(\u0027.thumbnails img\u0027);\r\n  thumbnails.forEach(thumb =\u003e thumb.classList.remove(\u0027selected\u0027));\r\n  element.classList.add(\u0027selected\u0027);\r\n}\r\n\r\n// مقداردهی اولیه: اولین تصویر انتخاب شده باشد\r\ndocument.querySelector(\u0027.thumbnails img\u0027).classList.add(\u0027selected\u0027);\r\n\r\n// Lightbox\r\nfunction openLightbox(src) {\r\n  document.getElementById(\u0027lightbox-img\u0027).src = src;\r\n  document.getElementById(\u0027lightbox\u0027).style.display = \u0027flex\u0027;\r\n}\r\n\r\nfunction closeLightbox() {\r\n  document.getElementById(\u0027lightbox\u0027).style.display = \u0027none\u0027;\r\n}\r\n\u003c/script\u003e\r\n\t\t\t\t\u003c/div\u003e\n\t\t\t\t\u003c/div\u003e\n\t\t\t\t\u003csection class=\"elementor-section elementor-inner-section elementor-element elementor-element-89a53f5 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"89a53f5\" data-element_type=\"section\" data-e-type=\"section\"\u003e\n\t\t\t\t\t\t\u003cdiv class=\"elementor-container elementor-column-gap-custom\"\u003e\n\t\t\t\t\t\u003cdiv class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-e638d29\" data-id=\"e638d29\" d