{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sahand Laser product data",
  "type": "object",
  "required": ["code", "categoryId", "title", "subtitle", "advantages", "specs", "usage", "models", "description", "media"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "categoryId": {"type": "string", "minLength": 1},
    "title": {"$ref": "#/$defs/localizedText"},
    "subtitle": {"$ref": "#/$defs/localizedText"},
    "advantages": {"type": "array"},
    "specs": {"type": "array", "items": {"type": "object", "required": ["label", "value"], "properties": {"label": {"$ref": "#/$defs/localizedText"}, "value": {"type": "string"}, "scope": {"type": "string"}}}},
    "usage": {"type": "array"},
    "models": {"type": "array"},
    "description": {"type": "object", "required": ["fa"], "properties": {"fa": {"type": "array", "items": {"type": "string"}}}},
    "media": {
      "type": "object",
      "required": ["images", "frames360", "works"],
      "properties": {
        "images": {"$ref": "#/$defs/paths"},
        "frames360": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "oneOf": [{"maxItems": 0}, {"minItems": 12, "maxItems": 12}]},
        "works": {"$ref": "#/$defs/paths"},
        "model": {"type": "string"},
        "modelPreview": {"type": "string"},
        "technical": {"type": "string"},
        "exploded": {"type": "string"},
        "cutaway": {"type": "string"},
        "caption": {"$ref": "#/$defs/localizedText"}
      }
    },
    "downloads": {"type": "array", "items": {"type": "object", "required": ["title", "path"], "properties": {"title": {"$ref": "#/$defs/localizedText"}, "path": {"type": "string"}}}}
  },
  "$defs": {
    "localizedText": {"type": "object", "required": ["fa"], "properties": {"fa": {"type": "string"}, "en": {"type": "string"}, "ar": {"type": "string"}, "tr": {"type": "string"}}},
    "paths": {"type": "array", "items": {"type": "string"}}
  }
}
