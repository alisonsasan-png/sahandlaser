# Copy this file to .env, then add your API key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Product source pages; product_links.txt can override with one URL per line.
PRODUCTS_PAGE_URL=https://sahandlaser.com/laser-cutting-machine/
TRUSTED_HOSTS=sahandlaser.com
DEFAULT_DIMENSION_UNIT=mm
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT=25

# Local preview
PREVIEW_PORT=3333

# Optional paths
LOGO_PATH=logo.png
# FONT_PATH=C:/Windows/Fonts/tahoma.ttf
