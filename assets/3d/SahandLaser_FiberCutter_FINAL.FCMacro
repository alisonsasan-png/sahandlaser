sh.Label = "Reference dimensions"
rows = [
("A1","Parameter"),("B1","Value_mm"),
("A2","Overall length"),("B2",str(L)),
("A3","Overall width"),("B3",str(W)),
("A4","Body height"),("B4",str(BODY_H)),
("A5","Cutting length"),("B5",str(WORK_L)),
("A6","Cutting width"),("B6",str(WORK_W)),
("A7","Status"),("B7","FINAL visual master"),
("A8","Note"),("B8","Approximate model from photos - not production certified"),
]
