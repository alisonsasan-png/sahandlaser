import FreeCAD as App
import Part

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None

DOC_NAME = "SahandLaser_FiberCutter_FINAL"

# ---------- reset ----------
for d in list(App.listDocuments().values()):
    if d.Name == DOC_NAME:
        App.closeDocument(d.Name)
doc = App.newDocument(DOC_NAME)

# ---------- PARAMETERS ----------
L = 4000.0
W = 2000.0
BODY_H = 700.0
WORK_L = 3000.0
WORK_W = 1500.0

FRAME_Z = 150.0
BED_X = (L-WORK_L)/2
BED_Y = (W-WORK_W)/2
BED_Z = 440.0

YRAIL_Z = 610.0
GANTRY_X = 2100.0
GANTRY_Z = 735.0
GANTRY_W = 245.0
GANTRY_H = 250.0

# ---------- COLORS ----------
BLUE       = (0.055, 0.255, 0.455)
BLUE_LIGHT = (0.085, 0.355, 0.610)
BLUE_DARK  = (0.035, 0.120, 0.215)
BLACK      = (0.045, 0.045, 0.055)
DARKGRAY   = (0.18, 0.19, 0.21)
MIDGRAY    = (0.42, 0.44, 0.47)
STEEL      = (0.72, 0.74, 0.77)
SILVER     = (0.84, 0.86, 0.89)
GREEN      = (0.06, 0.92, 0.28)
RED        = (0.90, 0.04, 0.05)
WHITE      = (0.92, 0.93, 0.94)
YELLOW     = (0.95, 0.68, 0.08)

# ---------- helpers ----------
def grp(name, label):
    g = doc.addObject("App::DocumentObjectGroup", name)
    g.Label = label
    return g

def feat(name, shape, color=BLUE, label=None):
    o = doc.addObject("Part::Feature", name)
    o.Shape = shape
    if label: o.Label = label
    try:
        o.ViewObject.ShapeColor = color
        o.ViewObject.LineColor = (0.12,0.12,0.12)
        o.ViewObject.LineWidth = 1.0
    except:
        pass
    return o

def box(name,x,y,z,dx,dy,dz,color=BLUE,label=None):
    return feat(name,Part.makeBox(dx,dy,dz,App.Vector(x,y,z)),color,label)

def cz(name,x,y,z,r,h,color=STEEL,label=None):
    return feat(name,Part.makeCylinder(r,h,App.Vector(x,y,z),App.Vector(0,0,1)),color,label)

def cx(name,x,y,z,r,h,color=STEEL,label=None):
    return feat(name,Part.makeCylinder(r,h,App.Vector(x,y,z),App.Vector(1,0,0)),color,label)

def cy(name,x,y,z,r,h,color=STEEL,label=None):
    return feat(name,Part.makeCylinder(r,h,App.Vector(x,y,z),App.Vector(0,1,0)),color,label)

def add(g, *objs):
    for o in objs:
        if o: g.addObject(o)

def chamfered_box(name,x,y,z,dx,dy,dz,ch=30,color=BLUE,label=None):
    s = Part.makeBox(dx,dy,dz,App.Vector(x,y,z))
    try:
        edges = [e for e in s.Edges if abs((e.Vertexes[-1].Point-e.Vertexes[0].Point).z) > dz*0.8]
        if edges:
            s = s.makeChamfer(ch, edges[:min(4,len(edges))])
    except:
        pass
    return feat(name,s,color,label)

# ---------- groups ----------
G_PARAM = grp("G00_PARAMETERS","00 - Parameters")
G_FRAME = grp("G01_FRAME","01 - Main chassis")
G_BED = grp("G02_BED","02 - Cutting bed")
G_MOTION = grp("G03_MOTION","03 - Rails / rack / gantry")
G_CARR = grp("G04_CARRIAGE","04 - Z carriage / laser head")
G_COV = grp("G05_COVERS","05 - Covers / body panels")
G_CHAIN = grp("G06_CABLE_CHAINS","06 - Cable chains")
G_CTRL = grp("G07_CONTROL","07 - Control console")
G_DETAIL = grp("G08_DETAILS","08 - Bolts / vents / wiring / details")

# ---------- spreadsheet ----------
